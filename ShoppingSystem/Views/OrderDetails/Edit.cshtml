@model ShoppingSystem.ViewModels.OrderDetailsFormViewModel

@{
    ViewData["Title"] = "Edit Order Detail";
}

<h1 class="mb-3">Edit Order Detail</h1>

<form asp-controller="OrderDetails" asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input asp-for="OrderId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3 mb-3">
        <div class="col-md-8 col-lg-6">
            <label asp-for="ProductId" class="form-label"></label>
            <select asp-for="ProductId" class="form-select" required>
                <option value="">Select a product</option>
                @foreach (var product in Model.Products)
                {
                    <option value="@product.Id">@product.Name</option>
                }
            </select>
            <span asp-validation-for="ProductId" class="text-danger small"></span>
        </div>

        <div class="col-md-4 col-lg-3">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" type="number" min="0.001" step="0.001" class="form-control" required />
            <span asp-validation-for="Quantity" class="text-danger small"></span>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-controller="Orders" asp-action="Index" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary">Back to Order</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
