@model OrderDetails

@{
    ViewData["Title"] = "Delete Order Detail";
}

<h1 class="mb-3">Delete Order Detail</h1>

<section>
    <p class="alert alert-warning">Are you sure you want to delete this product from the order?</p>

    <dl class="row">
        <dt class="col-sm-3">Product</dt>
        <dd class="col-sm-9">@Model.Product.Name</dd>

        <dt class="col-sm-3">Quantity</dt>
        <dd class="col-sm-9">@Model.Quantity</dd>
    </dl>

    <form asp-controller="OrderDetails" asp-action="Delete" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-controller="Orders" asp-action="Index" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</section>
