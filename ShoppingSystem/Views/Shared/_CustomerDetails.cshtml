@model Customer

<dl class="row mb-4">
    <dt class="col-sm-4">Last name</dt>
    <dd class="col-sm-8 text-break">@Model.LastName</dd>

    <dt class="col-sm-4">First name</dt>
    <dd class="col-sm-8 text-break">@Model.FirstName</dd>

    <dt class="col-sm-4">Address</dt>
    <dd class="col-sm-8 text-break">@Model.Address</dd>

    <dt class="col-sm-4">Discount</dt>
    <dd class="col-sm-8">@Model.Discount</dd>
</dl>
