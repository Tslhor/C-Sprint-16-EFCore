@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section>
    <h1 class="text-danger mb-3">Something went wrong</h1>
    <p class="text-body-secondary">An error occurred while processing your request. Please try again.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-body-secondary text-break">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
</section>
