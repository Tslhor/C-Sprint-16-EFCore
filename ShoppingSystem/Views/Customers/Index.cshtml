@model IEnumerable<Customer>

@{
    ViewData["Title"] = "Customers";
}

<h1 class="mb-3">Customers</h1>

<p class="mb-4">
    <a asp-controller="Customers" asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<form asp-controller="Customers" asp-action="Index" method="get" class="mb-4" role="search">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <label for="searchString" class="form-label mb-0">Find by name:</label>
        <div class="col-12 col-sm-5 col-lg-3">
            <input id="searchString" name="searchString" type="search" class="form-control" />
        </div>
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-controller="Customers" asp-action="Index" class="ms-sm-2">Back to Full List</a>
    </div>
    <div id="search-help" class="form-text">Search by first name or last name.</div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <caption class="visually-hidden">Customers and available actions</caption>
        <thead>
            <tr>
                <th scope="col">
                    <a asp-controller="Customers" asp-action="Index" asp-route-sortOrder="lastName">Last name</a>
                </th>
                <th scope="col">First name</th>
                <th scope="col">
                    <a asp-controller="Customers" asp-action="Index" asp-route-sortOrder="address">Address</a>
                </th>
                <th scope="col">Discount</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>

            @foreach (var customer in Model)
            {
                <tr>
                    <td class="text-break">@customer.LastName</td>
                    <td class="text-break">@customer.FirstName</td>
                    <td class="text-break">@customer.Address</td>
                    <td>@customer.Discount</td>
                    <td class="text-nowrap text-end">
                        <a asp-controller="Customers" asp-action="Edit" asp-route-id="@customer.Id">Edit</a>
                        |
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@customer.Id">Details</a> |
                        <a asp-controller="Customers" asp-action="Delete" asp-route-id="@customer.Id" class="text-danger">Delete</a>
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-body-secondary py-4">
                        No customer data loaded.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
