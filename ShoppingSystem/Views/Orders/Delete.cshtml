@model Order

@{
    ViewData["Title"] = "Delete Order";
}

<h1 class="mb-3">Delete Order</h1>

<section>
    <p class="alert alert-warning">Are you sure you want to delete this order?</p>

    <dl class="row">
        <dt class="col-sm-3">Order date</dt>
        <dd class="col-sm-9">@Model.OrderDate</dd>

        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@Model.Customer.FirstName @Model.Customer.LastName</dd>

        <dt class="col-sm-3">Supermarket</dt>
        <dd class="col-sm-9">@Model.Supermarket.Name</dd>
    </dl>

    <form asp-controller="Orders" asp-action="Delete" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-controller="Orders" asp-action="Index" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</section>
