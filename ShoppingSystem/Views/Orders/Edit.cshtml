@model ShoppingSystem.ViewModels.OrderFormViewModel

@{
    ViewData["Title"] = "Edit Order";
}

<h1 class="mb-3">Edit Order</h1>

<form asp-controller="Orders" asp-action="Edit" asp-route-id="@ViewData["OrderId"]" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3 mb-3">
        <div class="col-md-6 col-lg-4">
            <label asp-for="CustomerId" class="form-label"></label>
            <select asp-for="CustomerId" class="form-select" required>
                <option value="">Select a customer</option>
                @foreach (var customer in Model.Customers)
                {
                    <option value="@customer.Id">@customer.FirstName @customer.LastName</option>
                }
            </select>
            <span asp-validation-for="CustomerId" class="text-danger small"></span>
        </div>

        <div class="col-md-6 col-lg-4">
            <label asp-for="SupermarketId" class="form-label"></label>
            <select asp-for="SupermarketId" class="form-select" required>
                <option value="">Select a supermarket</option>
                @foreach (var supermarket in Model.Supermarkets)
                {
                    <option value="@supermarket.Id">@supermarket.Name</option>
                }
            </select>
            <span asp-validation-for="SupermarketId" class="text-danger small"></span>
        </div>

        <div class="col-md-6 col-lg-4">
            <label asp-for="OrderDate" class="form-label"></label>
            <input asp-for="OrderDate" type="date" class="form-control" required />
            <span asp-validation-for="OrderDate" class="text-danger small"></span>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-controller="Orders" asp-action="Index" asp-route-id="@ViewData["OrderId"]" class="btn btn-outline-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
